PORT=3000
# Local Docker Compose (see repo root docker-compose.yml)
DATABASE_URL=postgresql://sofinda:sofinda@localhost:5432/sofinda
REDIS_URL=redis://localhost:6379

# Auth (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_DAYS=7

# Comma-separated browser origins allowed for CORS (production). Dev defaults to localhost.
# Exact origins and/or *.vercel.app for all Vercel preview + prod URLs
# CORS_ORIGINS=https://land-edge-api.vercel.app,*.vercel.app

# Public web URL for password reset / invite links in emails
APP_PUBLIC_URL=http://localhost:5173

# Optional invoice email delivery (used by POST /api/v1/billing/invoices/:id/send-email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Lipila payments (https://docs.lipila.dev/, https://blaze-docs.lipila.dev/)
LIPILA_API_KEY=
# Base64-encoded 32-byte webhook signing secret from Lipila dashboard (Settings → Webhooks)
LIPILA_WEBHOOK_SECRET=
# Public URL Lipila will call for async collection callbacks (must match your deployed route)
LIPILA_WEBHOOK_CALLBACK_URL=
# Optional; default https://api.lipila.dev (sandbox vs live keys select mode per Lipila)
LIPILA_API_BASE_URL=
